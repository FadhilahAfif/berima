# Copy to .maestro/.env and fill in values.
# Maestro reads these via the run.ps1 script or `--env KEY=VAL` on the CLI.

# Buyer account (Dian Rahayu)
BERIMA_TEST_EMAIL=<your_test_buyer_email>
BERIMA_TEST_PASSWORD=<your_test_password>

# Seller account (Andi Pratama) - reserved for future dual-account flows
BERIMA_TEST_SELLER_EMAIL=<your_test_seller_email>
BERIMA_TEST_SELLER_PASSWORD=<your_test_seller_password>

# Per-run suffix to avoid duplicate listing titles. Auto-set by run.ps1.
BERIMA_RUN_ID=local

# A seeded listing NOT owned by the buyer. Used by flows 60, 61, 62.
# Andi's listings are safe - Dian (buyer) will never own them.
BERIMA_TEST_LISTING_TITLE=Desain PPT Presentasi Sidang

# A paid order with hasReview=false owned by the buyer.
# The seeded "Desain PPT Presentasi Sidang" order is paid but hasReview=true after
# the first review run. Reset it before rerunning flow 63:
#   $env:FIREBASE_ACCESS_TOKEN = (firebase auth:print-access-token)
#   node scripts/patch-order-hasreview.js
# Then set this to the seeded order title:
BERIMA_TEST_PAID_ORDER_TITLE=Desain PPT Presentasi Sidang
