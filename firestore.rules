rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function missingOrNull(field) {
      return !(field in request.resource.data) || request.resource.data[field] == null;
    }

    function validCategory(category) {
      return category in ["academic", "visual", "data"];
    }

    function safeUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "photoUrl",
          "bio",
          "faculty",
          "role",
          "identityVerificationStatus",
          "isIdentityVerified",
          "verifiedSkillBadges",
          "verificationUpdatedAt",
          "averageRating",
          "totalReviews",
          "totalOrdersAsBuyer",
          "totalOrdersAsSeller",
          "createdAt"
        ])
        && (!("uid" in request.resource.data) || request.resource.data.uid == userId)
        && (!("identityVerificationStatus" in request.resource.data)
          || request.resource.data.identityVerificationStatus == "not_submitted")
        && (!("isIdentityVerified" in request.resource.data)
          || request.resource.data.isIdentityVerified == false)
        && (!("verifiedSkillBadges" in request.resource.data)
          || (request.resource.data.verifiedSkillBadges is list
            && request.resource.data.verifiedSkillBadges.size() == 0))
        && missingOrNull("verificationUpdatedAt");
    }

    function safeUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name",
        "bio",
        "faculty",
        "role",
        "photoUrl"
      ]);
    }

    function noClientReviewFields() {
      return missingOrNull("rejectionReason")
        && missingOrNull("reviewedBy")
        && missingOrNull("reviewedAt");
    }

    function validVerificationSubmission(submissionId) {
      return request.resource.data.keys().hasOnly([
          "submissionId",
          "userId",
          "type",
          "status",
          "documentType",
          "skillCategory",
          "portfolioItemId",
          "externalLink",
          "storagePath",
          "fileName",
          "contentType",
          "note",
          "rejectionReason",
          "reviewedBy",
          "reviewedAt",
          "createdAt",
          "updatedAt"
        ])
        && (!("submissionId" in request.resource.data)
          || request.resource.data.submissionId == submissionId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && noClientReviewFields()
        && (
          (
            request.resource.data.type == "identity"
            && request.resource.data.documentType == "ktm"
            && missingOrNull("skillCategory")
            && missingOrNull("portfolioItemId")
            && missingOrNull("externalLink")
          )
          ||
          (
            request.resource.data.type == "skill"
            && validCategory(request.resource.data.skillCategory)
            && missingOrNull("documentType")
          )
        );
    }

    function validPortfolioItem(portfolioItemId) {
      return request.resource.data.keys().hasOnly([
          "portfolioItemId",
          "userId",
          "title",
          "description",
          "category",
          "externalLink",
          "imageUrl",
          "imageStoragePath",
          "createdAt",
          "updatedAt"
        ])
        && (!("portfolioItemId" in request.resource.data)
          || request.resource.data.portfolioItemId == portfolioItemId)
        && request.resource.data.userId == request.auth.uid
        && validCategory(request.resource.data.category);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && safeUserCreate(userId);
      allow update: if isOwner(userId) && safeUserUpdate();
    }

    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if isSignedIn()
        && resource.data.sellerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.buyerId
        || request.auth.uid == resource.data.sellerId);
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId
        && request.resource.data.price == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.price;
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.buyerId
        || request.auth.uid == resource.data.sellerId)
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.price == resource.data.price;
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.buyerId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == "paid"
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.hasReview == false;
    }

    match /messages/{orderId}/chats/{messageId} {
      allow read, write: if isSignedIn()
        && (request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId
        || request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId);
    }

    match /verificationSubmissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && validVerificationSubmission(submissionId);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type
        && resource.data.status == "rejected"
        && validVerificationSubmission(submissionId);
    }

    match /portfolioItems/{portfolioItemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && validPortfolioItem(portfolioItemId);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && validPortfolioItem(portfolioItemId);
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
